# ROM images and anything derived from them. Never commit copyrighted data.
roms/
*.sfc
*.smc
*.swc
*.fig
*.srm
# The asset pack ct_native imports from the ROM (frontend/assets.h)
*.assets
!saves/**/*.srm
*.spc

# Extracted assets, disassembly output, traces and captures
extracted/
disasm/out/
traces/
captures/
*.cttr
*.wram
*.wav
*.state

# Reference emulator cores are supplied locally, never vendored
cores/
*_libretro.dll
*_libretro.so
*_libretro.dylib

# Build output
build/
build-*/
out/
cmake-build-*/
target/

# Tooling
__pycache__/
*.pyc
.venv/
.vs/
.vscode/
.idea/
*.user

# Player binaries built by tools/dist.py
dist/

# Linked worktrees kept inside the checkout
.worktrees/

# Native checkpoints contain cartridge-derived game state
*.native-state
