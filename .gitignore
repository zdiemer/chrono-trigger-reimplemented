# ROM images and anything derived from them. Never commit copyrighted data.
roms/
*.sfc
*.smc
*.swc
*.fig
*.srm
!oracle/saves/**/*.srm
*.spc

# Extracted assets, disassembly output, traces and captures
extracted/
disasm/out/
traces/
captures/
*.cttr
*.wram
*.wav
*.state

# Reference emulator cores are supplied locally, never vendored
cores/
*_libretro.dll
*_libretro.so
*_libretro.dylib

# Build output
build/
build-*/
out/
cmake-build-*/
target/

# Tooling
__pycache__/
*.pyc
.venv/
.vs/
.vscode/
.idea/
*.user

# Downloaded test suites
tests/cpu/data/
tests/apu/data/

# Player binaries built by tools/dist.py
dist/
